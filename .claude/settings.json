{
  "enabledPlugins": {
    "gitmoji@ddaanet": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/plugin-dev/version-guard.sh"
          }
        ]
      }
    ]
  },
  "pluginConfigs": {
    "gitmoji@ddaanet": {
      "options": {
        "enabled": true
      }
    }
  }
}
