{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/plugin-dev/version-guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "pluginConfigs": {
    "gitmoji@ddaanet": {
      "options": {
        "enabled": true
      }
    }
  },
  "gitlore": {
    "enabled": true,
    "precommitCommand": "just precommit"
  }
}
